{
  "name": "chrome-seed",
  "version": "1.0.0",
  "description": "A modern Chrome extension boilerplate built with TypeScript, React, and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "type-check": "tsc --noEmit",
    "postbuild": "node scripts/package.js",
    "package": "npm run build"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "react",
    "vite"
  ],
  "author": "Sujal Shah",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/archiver": "6.0.3",
    "@types/chrome": "0.1.3",
    "@types/chrome-webstore-upload": "1.0.0",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "terser": "5.43.1",
    "typescript": "5.9.2",
    "vite": "7.1.2"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
